rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwnerOrAdmin(businessId) {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.owner_uid == request.auth.uid
        )
      );
    }

    match /businesses/{businessId} {
      allow get: if request.auth != null ? true : (resource != null && resource.data.active == true);
      allow list: if isSignedIn() && resource.data.owner_uid == request.auth.uid;
      allow create, update: if isSignedIn() &&
        request.resource.data.business_id == businessId &&
        request.resource.data.business_name is string &&
        request.resource.data.business_name.size() <= 120;
      allow delete: if isOwnerOrAdmin(businessId);

      match /services/{serviceId} {
        allow read: if resource == null || resource.data.active == true || isOwnerOrAdmin(businessId);
        allow write: if isOwnerOrAdmin(businessId);
      }

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isOwnerOrAdmin(businessId);
      }

      match /qr_codes/{qrId} {
        allow read: if resource == null || resource.data.active == true || isOwnerOrAdmin(businessId);
        allow write: if isOwnerOrAdmin(businessId);
      }

      match /feedback/{feedbackId} {
        allow read: if isOwnerOrAdmin(businessId);
        allow create: if exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          request.resource.data.feedback_id == feedbackId &&
          request.resource.data.customer_answers is map &&
          request.resource.data.submitted_at == request.time;
        allow update, delete: if false;
      }

      match /review_drafts/{reviewId} {
        allow read: if isOwnerOrAdmin(businessId);
        allow create: if exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          request.resource.data.review_id == reviewId &&
          request.resource.data.generated_text is string &&
          request.resource.data.generated_text.size() <= 3000 &&
          request.resource.data.created_at == request.time;
        allow update, delete: if false;
      }

      match /usage_logs/{requestId} {
        allow read: if isOwnerOrAdmin(businessId);
        allow create: if exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          request.resource.data.request_id == requestId &&
          request.resource.data.total_tokens is int &&
          request.resource.data.total_tokens >= 0 &&
          request.resource.data.created_at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
