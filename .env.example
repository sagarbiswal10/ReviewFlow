# ==============================================================================
# ReviewFlow Environment Variables (Self-Hosted / GitHub Deployment)
# Copy this file to .env and fill in your own credentials before running.
# ==============================================================================

# --- Server Configuration ---
PORT="3000"

# Comma-separated browser origins allowed to call your backend API (e.g. when
# frontend and backend are hosted on separate domains). Leave empty for same-origin.
ALLOWED_ORIGINS=""

# Set to "true" in self-hosted environments to omit AI Studio User-Agent telemetry headers.
DISABLE_AISTUDIO_HEADER="true"

# Require verified Firebase ID tokens (Authorization: Bearer <token>) on protected API routes.
API_AUTH_REQUIRED="true"

# Your Firebase Project ID (used by the backend to verify Firebase ID tokens).
FIREBASE_PROJECT_ID=""

# --- AI Provider Configuration (Server-Side Only) ---
# Choose "gemini" (default) or "openai".
AI_PROVIDER="gemini"

# Option A: Google Gemini API Key or Vertex AI Express Key (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-4-hydrogen"
# Set to "true" ONLY if using Vertex AI Express Mode (requires Cloud Billing)
GOOGLE_GENAI_USE_VERTEXAI="false"

# Option B: OpenAI-compatible API Key (used when AI_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Frontend Build Variables (Vite - Exposed to Browser) ---
# Optional primary administrator email for Management Console (/admin) bootstrap.
# Leave empty to manage administrators solely via Firestore /admins/{uid} documents.
VITE_ADMIN_EMAIL=""

# Custom backend API base URL if hosted separately (e.g. "https://api.yourdomain.com").
# Leave empty to call same-origin "/api/*".
VITE_API_BASE_URL=""

# Public frontend domain used inside generated QR codes (e.g. "https://reviews.yourdomain.com").
# Leave empty to use window.location.origin automatically.
VITE_PUBLIC_APP_URL=""

# Your own Firebase Web App configuration (overrides firebase-applet-config.json when set).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Leave empty to use the standard "(default)" Firestore database in your own Firebase project.
VITE_FIREBASE_DATABASE_ID=""
