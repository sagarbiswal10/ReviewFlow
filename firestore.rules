rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userEmailLower() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        userEmailLower() == 'harkiratcourse36@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (userEmailLower().size() > 0 && exists(/databases/$(database)/documents/adminEmails/$(userEmailLower())))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string &&
        emailId.size() >= 3 &&
        emailId.size() <= 120 &&
        emailId == emailId.lower() &&
        emailId.matches('^[^/\\s@]+@[^/\\s@]+\\.[^/\\s@]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 80 && slug.matches('^[a-z0-9-]+$');
    }

    function isValidCategory(cat) {
      return cat in [
        'Restaurants',
        'Hair Salons',
        'Beauty Salons',
        'Hotels',
        'Spas',
        'Gyms',
        'Healthcare',
        'Retail Stores',
        'Automobile Services',
        'Other Businesses'
      ];
    }

    function isValidLifecycleStatus(st) {
      return st in ['onboarding', 'provisioning', 'active', 'suspended'];
    }

    function isValidFormTemplate(tpl) {
      return tpl in [
        'classic_cards',
        'emoji_checklist_light',
        'emoji_checklist_dark',
        'warm_editorial',
        'split_executive',
        'quick_tap_express'
      ];
    }

    function isValidTenantFirebase(tf) {
      return tf == null || (
        tf is map &&
        tf.keys().hasAll(['projectId', 'apiKey', 'authDomain', 'appId', 'databaseId']) &&
        tf.keys().hasOnly(['projectId', 'apiKey', 'authDomain', 'appId', 'databaseId', 'storageBucket']) &&
        tf.projectId is string && tf.projectId.size() <= 120 &&
        tf.apiKey is string && tf.apiKey.size() <= 120 &&
        tf.authDomain is string && tf.authDomain.size() <= 160 &&
        tf.appId is string && tf.appId.size() <= 160 &&
        tf.databaseId is string && tf.databaseId.size() <= 80
      );
    }

    function isValidEnabledFeatures(f) {
      return f is map &&
        f.keys().hasAll(['aiReviewDrafts', 'customQuestions', 'pdfPosterExport', 'analyticsView']) &&
        f.keys().hasOnly([
          'aiReviewDrafts', 'customQuestions', 'pdfPosterExport', 'analyticsView',
          'inStoreQrStands', 'gbpAutoReply', 'weeklyReports'
        ]) &&
        f.aiReviewDrafts is bool &&
        f.customQuestions is bool &&
        f.pdfPosterExport is bool &&
        f.analyticsView is bool &&
        (!('inStoreQrStands' in f) || f.inStoreQrStands is bool) &&
        (!('gbpAutoReply' in f) || f.gbpAutoReply is bool) &&
        (!('weeklyReports' in f) || f.weeklyReports is bool);
    }

    function isValidBranding(b) {
      return b is map &&
        b.keys().hasAll(['primaryColor', 'secondaryColor', 'welcomeMessage', 'thankYouMessage', 'defaultReviewStyle']) &&
        b.keys().hasOnly(['primaryColor', 'secondaryColor', 'welcomeMessage', 'thankYouMessage', 'defaultReviewStyle']) &&
        b.primaryColor is string && b.primaryColor.size() >= 4 && b.primaryColor.size() <= 20 &&
        b.secondaryColor is string && b.secondaryColor.size() >= 4 && b.secondaryColor.size() <= 20 &&
        b.welcomeMessage is string && b.welcomeMessage.size() <= 240 &&
        b.thankYouMessage is string && b.thankYouMessage.size() <= 240 &&
        b.defaultReviewStyle in ['short', 'detailed', 'professional'];
    }

    function isValidQrConfig(q) {
      return q is map &&
        q.keys().hasAll(['isActive', 'fgColor', 'bgColor', 'token', 'includeLogo']) &&
        q.keys().hasOnly(['isActive', 'fgColor', 'bgColor', 'token', 'includeLogo']) &&
        q.isActive is bool &&
        q.fgColor is string && q.fgColor.size() >= 4 && q.fgColor.size() <= 20 &&
        q.bgColor is string && q.bgColor.size() >= 4 && q.bgColor.size() <= 20 &&
        q.token is string && q.token.size() >= 4 && q.token.size() <= 64 &&
        q.includeLogo is bool;
    }

    function isValidGbpSettings(g) {
      return g is map &&
        g.keys().hasAll(['fiveStarMode', 'midStarMode', 'lowStarMode', 'brandVoice', 'autoSyncEnabled']) &&
        g.keys().hasOnly(['fiveStarMode', 'midStarMode', 'lowStarMode', 'brandVoice', 'autoSyncEnabled']) &&
        g.fiveStarMode in ['auto_publish', 'approval_required'] &&
        g.midStarMode in ['auto_publish', 'approval_required'] &&
        g.lowStarMode == 'manual_approval_only' &&
        g.brandVoice is string && g.brandVoice.size() <= 400 &&
        g.autoSyncEnabled is bool;
    }

    function isValidWeeklyReportConfig(w) {
      return w is map &&
        w.keys().hasAll(['enabled', 'recipients', 'autoMondayEnabled']) &&
        w.keys().hasOnly(['enabled', 'recipients', 'autoMondayEnabled', 'lastGeneratedWeekKey']) &&
        w.enabled is bool &&
        w.recipients is list && w.recipients.size() <= 10 &&
        (w.recipients.size() == 0 || (w.recipients[0] is string && w.recipients[0].size() <= 120)) &&
        w.autoMondayEnabled is bool &&
        (!('lastGeneratedWeekKey' in w) || (w.lastGeneratedWeekKey is string && w.lastGeneratedWeekKey.size() <= 24));
    }

    function isValidQuestions(questions) {
      return questions is list &&
        questions.size() <= 25 &&
        (questions.size() == 0 || questions[0] is map);
    }

    function isValidSeoKeywords(keywords) {
      return keywords is list &&
        keywords.size() <= 15 &&
        (keywords.size() == 0 || (keywords[0] is string && keywords[0].size() <= 60));
    }

    function isAssignedClient(data) {
      return isVerifiedUser() && (
        data.ownerId == request.auth.uid ||
        (data.clientEmail is string && data.clientEmail.size() > 0 && data.clientEmail.lower() == userEmailLower())
      );
    }

    function getBusinessStandLimit(bizId) {
      return (
        'qrStandLimit' in get(/databases/$(database)/documents/businesses/$(bizId)).data &&
        get(/databases/$(database)/documents/businesses/$(bizId)).data.qrStandLimit is int
      ) ? get(/databases/$(database)/documents/businesses/$(bizId)).data.qrStandLimit : 4;
    }

    function isValidBusiness(data) {
      return data.keys().hasAll([
          'ownerId', 'clientEmail', 'clientAccessLevel', 'enabledFeatures',
          'slug', 'name', 'category', 'address', 'phone',
          'contactEmail', 'googleReviewUrl', 'logoDataUrl', 'branding',
          'qrConfig', 'questions', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'ownerName', 'clientEmail', 'clientUid', 'clientAccessLevel', 'enabledFeatures',
          'slug', 'name', 'category', 'address', 'phone',
          'contactEmail', 'website', 'googleReviewUrl', 'logoDataUrl', 'branding',
          'qrConfig', 'questions', 'formTemplate', 'seoKeywords', 'qrStandLimit', 'gbpSettings', 'weeklyReportConfig',
          'lifecycleStatus', 'tenantFirebase', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        data.clientAccessLevel in ['read_only', 'qr_and_questions', 'full'] &&
        isValidEnabledFeatures(data.enabledFeatures) &&
        isValidSlug(data.slug) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidCategory(data.category) &&
        data.address is string && data.address.size() <= 240 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.contactEmail is string && data.contactEmail.size() <= 120 &&
        (!('website' in data) || (data.website is string && data.website.size() <= 300)) &&
        data.googleReviewUrl is string && data.googleReviewUrl.size() <= 500 &&
        data.logoDataUrl is string && data.logoDataUrl.size() <= 350000 &&
        isValidBranding(data.branding) &&
        isValidQrConfig(data.qrConfig) &&
        isValidQuestions(data.questions) &&
        (!('formTemplate' in data) || isValidFormTemplate(data.formTemplate)) &&
        (!('seoKeywords' in data) || isValidSeoKeywords(data.seoKeywords)) &&
        (!('qrStandLimit' in data) || (data.qrStandLimit is int && data.qrStandLimit >= 1 && data.qrStandLimit <= 100)) &&
        (!('gbpSettings' in data) || isValidGbpSettings(data.gbpSettings)) &&
        (!('weeklyReportConfig' in data) || isValidWeeklyReportConfig(data.weeklyReportConfig)) &&
        (!('lifecycleStatus' in data) || isValidLifecycleStatus(data.lifecycleStatus)) &&
        (!('tenantFirebase' in data) || isValidTenantFirebase(data.tenantFirebase)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll([
          'businessId', 'ownerId', 'slug', 'name', 'category',
          'googleReviewUrl', 'logoDataUrl', 'enabledFeatures', 'branding',
          'qrConfig', 'questions', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'ownerId', 'clientUid', 'slug', 'name', 'category',
          'googleReviewUrl', 'logoDataUrl', 'enabledFeatures', 'branding',
          'qrConfig', 'questions', 'formTemplate', 'seoKeywords', 'lifecycleStatus', 'tenantFirebase',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        isValidSlug(data.slug) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidCategory(data.category) &&
        data.googleReviewUrl is string && data.googleReviewUrl.size() <= 500 &&
        data.logoDataUrl is string && data.logoDataUrl.size() <= 350000 &&
        isValidEnabledFeatures(data.enabledFeatures) &&
        isValidBranding(data.branding) &&
        isValidQrConfig(data.qrConfig) &&
        isValidQuestions(data.questions) &&
        (!('formTemplate' in data) || isValidFormTemplate(data.formTemplate)) &&
        (!('seoKeywords' in data) || isValidSeoKeywords(data.seoKeywords)) &&
        (!('lifecycleStatus' in data) || isValidLifecycleStatus(data.lifecycleStatus)) &&
        (!('tenantFirebase' in data) || isValidTenantFirebase(data.tenantFirebase)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBusinessStats(data) {
      return data.keys().hasAll([
          'businessId', 'ownerId', 'clientEmail', 'slug',
          'scans', 'generated', 'redirects',
          'styleShort', 'styleDetailed', 'styleProfessional', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'ownerId', 'clientEmail', 'slug',
          'scans', 'formsStarted', 'generated', 'redirects',
          'styleShort', 'styleDetailed', 'styleProfessional', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        isValidSlug(data.slug) &&
        data.scans is int && data.scans >= 0 &&
        (!('formsStarted' in data) || (data.formsStarted is int && data.formsStarted >= 0)) &&
        data.generated is int && data.generated >= 0 &&
        data.redirects is int && data.redirects >= 0 &&
        data.styleShort is int && data.styleShort >= 0 &&
        data.styleDetailed is int && data.styleDetailed >= 0 &&
        data.styleProfessional is int && data.styleProfessional >= 0 &&
        data.updatedAt is timestamp;
    }

    function isValidReviewEvent(data) {
      return data.keys().hasAll([
          'businessId', 'ownerId', 'slug', 'eventType',
          'reviewStyle', 'sentiment', 'selectedHighlights', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'ownerId', 'clientUid', 'slug', 'eventType',
          'reviewStyle', 'sentiment', 'language', 'selectedHighlights',
          'standId', 'standCode', 'standName', 'sessionId', 'createdAt'
        ]) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        isValidSlug(data.slug) &&
        data.eventType in ['scan', 'form_start', 'generate', 'copy_redirect'] &&
        data.reviewStyle is string && data.reviewStyle.size() <= 40 &&
        data.sentiment is string && data.sentiment.size() <= 40 &&
        (!('language' in data) || data.language in ['en', 'hi', 'mr', 'hinglish']) &&
        data.selectedHighlights is list && data.selectedHighlights.size() <= 15 &&
        (data.selectedHighlights.size() == 0 || data.selectedHighlights[0] is string) &&
        (!('standId' in data) || (data.standId is string && data.standId.size() <= 128)) &&
        (!('standCode' in data) || (data.standCode is string && data.standCode.size() <= 64)) &&
        (!('standName' in data) || (data.standName is string && data.standName.size() <= 120)) &&
        (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 128)) &&
        data.createdAt is timestamp;
    }

    function isValidFeedbackSubmission(data) {
      return data.keys().hasAll([
          'submissionId', 'businessId', 'ownerId', 'slug',
          'responses', 'additionalComments', 'sentiment', 'selectedHighlights',
          'sessionId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'submissionId', 'businessId', 'ownerId', 'clientUid', 'slug',
          'responses', 'additionalComments', 'sentiment', 'selectedHighlights',
          'standId', 'standCode', 'standName', 'sessionId', 'createdAt'
        ]) &&
        isValidId(data.submissionId) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        isValidSlug(data.slug) &&
        data.responses is list && data.responses.size() <= 25 &&
        (data.responses.size() == 0 || data.responses[0] is map) &&
        data.additionalComments is string && data.additionalComments.size() <= 2000 &&
        data.sentiment is string && data.sentiment.size() <= 40 &&
        data.selectedHighlights is list && data.selectedHighlights.size() <= 15 &&
        (data.selectedHighlights.size() == 0 || data.selectedHighlights[0] is string) &&
        (!('standId' in data) || (data.standId is string && data.standId.size() <= 128)) &&
        (!('standCode' in data) || (data.standCode is string && data.standCode.size() <= 64)) &&
        (!('standName' in data) || (data.standName is string && data.standName.size() <= 120)) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidReviewDraft(data) {
      return data.keys().hasAll([
          'draftId', 'businessId', 'ownerId', 'slug', 'feedbackSubmissionId',
          'reviewText', 'language', 'reviewStyle', 'variationSeed',
          'sessionId', 'status', 'generatedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'draftId', 'businessId', 'ownerId', 'clientUid', 'slug', 'feedbackSubmissionId',
          'reviewText', 'language', 'reviewStyle', 'variationSeed',
          'sessionId', 'status', 'generatedAt', 'copiedAt', 'deletedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.draftId) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        isValidSlug(data.slug) &&
        isValidId(data.feedbackSubmissionId) &&
        data.reviewText is string && data.reviewText.size() >= 1 && data.reviewText.size() <= 4000 &&
        data.language in ['en', 'hi', 'mr', 'hinglish'] &&
        data.reviewStyle in ['short', 'detailed', 'professional'] &&
        data.variationSeed is int && data.variationSeed >= 1 && data.variationSeed <= 1000 &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.status in ['Generated', 'Edited', 'Copied', 'Deleted'] &&
        data.generatedAt is timestamp &&
        (!('copiedAt' in data) || data.copiedAt is timestamp) &&
        (!('deletedAt' in data) || data.deletedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReviewEvaluation(data) {
      return data.keys().hasAll([
          'evalId', 'businessId', 'businessName', 'ownerId', 'slug', 'category',
          'language', 'reviewStyle', 'source', 'modelId', 'score', 'passed',
          'inventedClaimCount', 'contradictionCount', 'repetitionCount',
          'scriptCompliant', 'clicheCount', 'groundedFactCount', 'autoRepaired',
          'issues', 'responsesSummary', 'generatedReview', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'evalId', 'businessId', 'businessName', 'ownerId', 'clientUid', 'slug', 'category',
          'language', 'reviewStyle', 'draftId', 'source', 'modelId', 'score', 'passed',
          'inventedClaimCount', 'contradictionCount', 'repetitionCount',
          'scriptCompliant', 'clicheCount', 'groundedFactCount', 'autoRepaired',
          'issues', 'responsesSummary', 'generatedReview', 'createdAt'
        ]) &&
        isValidId(data.evalId) &&
        isValidId(data.businessId) &&
        data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        isValidSlug(data.slug) &&
        isValidCategory(data.category) &&
        data.language in ['en', 'hi', 'mr', 'hinglish'] &&
        data.reviewStyle in ['short', 'detailed', 'professional'] &&
        (!('draftId' in data) || (data.draftId is string && data.draftId.size() <= 128)) &&
        data.source in ['live_customer', 'admin_benchmark'] &&
        data.modelId is string && data.modelId.size() <= 80 &&
        data.score is int && data.score >= 0 && data.score <= 100 &&
        data.passed is bool &&
        data.inventedClaimCount is int && data.inventedClaimCount >= 0 && data.inventedClaimCount <= 100 &&
        data.contradictionCount is int && data.contradictionCount >= 0 && data.contradictionCount <= 100 &&
        data.repetitionCount is int && data.repetitionCount >= 0 && data.repetitionCount <= 100 &&
        data.scriptCompliant is bool &&
        data.clicheCount is int && data.clicheCount >= 0 && data.clicheCount <= 100 &&
        data.groundedFactCount is int && data.groundedFactCount >= 0 && data.groundedFactCount <= 100 &&
        data.autoRepaired is bool &&
        data.issues is list && data.issues.size() <= 15 &&
        (data.issues.size() == 0 || data.issues[0] is map) &&
        data.responsesSummary is string && data.responsesSummary.size() <= 2000 &&
        data.generatedReview is string && data.generatedReview.size() <= 4000 &&
        data.createdAt is timestamp;
    }

    function isValidConsentedExample(data) {
      return data.keys().hasAll([
          'exampleId', 'businessId', 'ownerId', 'slug', 'category',
          'language', 'reviewStyle', 'responsesSummary', 'additionalComments',
          'generatedReview', 'finalReview', 'qualityScore', 'consentGiven',
          'curationStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'exampleId', 'businessId', 'ownerId', 'slug', 'category',
          'language', 'reviewStyle', 'responsesSummary', 'additionalComments',
          'generatedReview', 'finalReview', 'qualityScore', 'consentGiven',
          'curationStatus', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.exampleId) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        isValidSlug(data.slug) &&
        isValidCategory(data.category) &&
        data.language in ['en', 'hi', 'mr', 'hinglish'] &&
        data.reviewStyle in ['short', 'detailed', 'professional'] &&
        data.responsesSummary is string && data.responsesSummary.size() <= 2000 &&
        data.additionalComments is string && data.additionalComments.size() <= 2000 &&
        data.generatedReview is string && data.generatedReview.size() >= 1 && data.generatedReview.size() <= 4000 &&
        data.finalReview is string && data.finalReview.size() >= 1 && data.finalReview.size() <= 4000 &&
        data.qualityScore is int && data.qualityScore >= 0 && data.qualityScore <= 100 &&
        data.consentGiven == true &&
        data.curationStatus in ['pending', 'approved', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQrStand(data) {
      return data.keys().hasAll([
          'businessId', 'ownerId', 'clientEmail', 'slug', 'slotNumber',
          'standCode', 'name', 'placement', 'isActive', 'fgColor', 'bgColor', 'includeLogo',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'ownerId', 'clientUid', 'clientEmail', 'slug', 'slotNumber',
          'standCode', 'name', 'placement', 'isActive', 'fgColor', 'bgColor', 'includeLogo',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        isValidSlug(data.slug) &&
        data.slotNumber is int && data.slotNumber >= 1 && data.slotNumber <= 100 &&
        isValidSlug(data.standCode) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.placement is string && data.placement.size() >= 1 && data.placement.size() <= 80 &&
        data.isActive is bool &&
        data.fgColor is string && data.fgColor.size() >= 4 && data.fgColor.size() <= 20 &&
        data.bgColor is string && data.bgColor.size() >= 4 && data.bgColor.size() <= 20 &&
        data.includeLogo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQrStandRequest(data) {
      return data.keys().hasAll([
          'businessId', 'businessName', 'ownerId', 'clientEmail',
          'requestedAdditionalStands', 'currentLimit', 'reason', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'businessName', 'ownerId', 'clientUid', 'clientEmail',
          'requestedAdditionalStands', 'currentLimit', 'reason', 'status',
          'reviewedByUid', 'reviewedByEmail', 'adminNote', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128)) &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        data.requestedAdditionalStands is int && data.requestedAdditionalStands >= 1 && data.requestedAdditionalStands <= 50 &&
        data.currentLimit is int && data.currentLimit >= 1 && data.currentLimit <= 100 &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 400 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewedByUid' in data) || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128)) &&
        (!('reviewedByEmail' in data) || (data.reviewedByEmail is string && data.reviewedByEmail.size() <= 120)) &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 400)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGbpConnection(data) {
      return data.keys().hasAll([
          'businessId', 'ownerId', 'clientEmail', 'connectionStatus',
          'connectedEmail', 'accountName', 'locationName', 'locationTitle', 'placeId',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'ownerId', 'clientEmail', 'connectionStatus',
          'connectedEmail', 'accountName', 'locationName', 'locationTitle', 'placeId',
          'lastSyncedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        data.connectionStatus in ['disconnected', 'connected', 'pending_api_approval'] &&
        data.connectedEmail is string && data.connectedEmail.size() <= 120 &&
        data.accountName is string && data.accountName.size() <= 160 &&
        data.locationName is string && data.locationName.size() <= 200 &&
        data.locationTitle is string && data.locationTitle.size() <= 160 &&
        data.placeId is string && data.placeId.size() <= 120 &&
        (!('lastSyncedAt' in data) || data.lastSyncedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGbpReview(data) {
      return data.keys().hasAll([
          'businessId', 'ownerId', 'clientEmail', 'externalReviewId', 'reviewerName',
          'starRating', 'comment', 'reviewDate', 'source', 'aiReplyText', 'replyStatus',
          'aiProvider', 'aiModelId', 'inputTokens', 'outputTokens', 'totalTokens',
          'estimatedCostUsd', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'ownerId', 'clientEmail', 'externalReviewId', 'reviewerName',
          'starRating', 'comment', 'reviewDate', 'source', 'aiReplyText', 'replyStatus',
          'aiProvider', 'aiModelId', 'inputTokens', 'outputTokens', 'totalTokens',
          'estimatedCostUsd', 'errorMessage', 'publishedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        data.externalReviewId is string && data.externalReviewId.size() >= 1 && data.externalReviewId.size() <= 160 &&
        data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 120 &&
        data.starRating is int && data.starRating >= 1 && data.starRating <= 5 &&
        data.comment is string && data.comment.size() <= 4000 &&
        data.reviewDate is string && data.reviewDate.size() <= 64 &&
        data.source in ['google_gbp_api', 'pubsub_webhook', 'manual_sync'] &&
        data.aiReplyText is string && data.aiReplyText.size() <= 4000 &&
        data.replyStatus in [
          'pending_generation', 'awaiting_approval', 'auto_published',
          'manually_approved', 'published', 'failed', 'ignored'
        ] &&
        (data.starRating > 2 || data.replyStatus != 'auto_published') &&
        data.aiProvider is string && data.aiProvider.size() <= 40 &&
        data.aiModelId is string && data.aiModelId.size() <= 80 &&
        data.inputTokens is int && data.inputTokens >= 0 &&
        data.outputTokens is int && data.outputTokens >= 0 &&
        data.totalTokens is int && data.totalTokens >= 0 &&
        data.estimatedCostUsd is number && data.estimatedCostUsd >= 0 &&
        (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 400)) &&
        (!('publishedAt' in data) || (data.publishedAt is string && data.publishedAt.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWeeklyReport(data) {
      return data.keys().hasAll([
          'businessId', 'businessName', 'ownerId', 'clientEmail', 'weekStart', 'weekEnd',
          'reviewGenMetrics', 'autoReplyMetrics', 'aiUsageMetrics',
          'dispatchedToEmails', 'generatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'businessName', 'ownerId', 'clientEmail', 'weekStart', 'weekEnd',
          'reviewGenMetrics', 'autoReplyMetrics', 'aiUsageMetrics',
          'dispatchedToEmails', 'dispatchedAt', 'generatedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        data.weekStart is string && data.weekStart.size() >= 8 && data.weekStart.size() <= 20 &&
        data.weekEnd is string && data.weekEnd.size() >= 8 && data.weekEnd.size() <= 20 &&
        data.reviewGenMetrics is map &&
        data.autoReplyMetrics is map &&
        data.aiUsageMetrics is map &&
        data.dispatchedToEmails is list && data.dispatchedToEmails.size() <= 15 &&
        (data.dispatchedToEmails.size() == 0 || (data.dispatchedToEmails[0] is string && data.dispatchedToEmails[0].size() <= 120)) &&
        (!('dispatchedAt' in data) || (data.dispatchedAt is string && data.dispatchedAt.size() <= 64)) &&
        data.generatedBy is string && data.generatedBy.size() >= 1 && data.generatedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBusinessIntegration(data) {
      return data.keys().hasAll([
          'businessId', 'ownerId', 'clientEmail', 'firebaseProjectId',
          'firebaseOwnershipModel', 'firebaseProvisioningStatus',
          'aiConnectionStatus', 'maskedGeminiKey', 'modelName',
          'totalTokensUsed', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'businessId', 'ownerId', 'clientEmail', 'firebaseProjectId',
          'firebaseOwnershipModel', 'firebaseProvisioningStatus',
          'aiConnectionStatus', 'maskedGeminiKey', 'modelName',
          'paymentStatus', 'totalTokensUsed', 'alertThresholds', 'updatedAt'
        ]) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.clientEmail is string && data.clientEmail.size() <= 120 &&
        data.firebaseProjectId is string && data.firebaseProjectId.size() <= 120 &&
        data.firebaseOwnershipModel in ['reviewflow_managed', 'customer_owned'] &&
        data.firebaseProvisioningStatus is string && data.firebaseProvisioningStatus.size() <= 40 &&
        data.aiConnectionStatus is string && data.aiConnectionStatus.size() <= 40 &&
        data.maskedGeminiKey is string && data.maskedGeminiKey.size() <= 64 &&
        data.modelName is string && data.modelName.size() <= 80 &&
        (!('paymentStatus' in data) || data.paymentStatus is string) &&
        data.totalTokensUsed is int && data.totalTokensUsed >= 0 &&
        data.updatedAt is timestamp;
    }

    function isValidAiUsageLog(data) {
      return data.keys().hasAll([
          'requestId', 'businessId', 'ownerId', 'modelName',
          'inputTokens', 'outputTokens', 'totalTokens', 'status', 'errorCode', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'requestId', 'businessId', 'ownerId', 'clientEmail', 'provider', 'operationType',
          'modelName', 'inputTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd',
          'status', 'errorCode', 'createdAt'
        ]) &&
        isValidId(data.requestId) &&
        isValidId(data.businessId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 120)) &&
        (!('provider' in data) || (data.provider is string && data.provider.size() <= 40)) &&
        (!('operationType' in data) || data.operationType in ['review_draft', 'gbp_auto_reply', 'seo_keywords']) &&
        data.modelName is string && data.modelName.size() <= 80 &&
        data.inputTokens is int && data.inputTokens >= 0 &&
        data.outputTokens is int && data.outputTokens >= 0 &&
        data.totalTokens is int && data.totalTokens >= 0 &&
        (!('estimatedCostUsd' in data) || (data.estimatedCostUsd is number && data.estimatedCostUsd >= 0)) &&
        data.status in ['success', 'failed'] &&
        data.errorCode is string && data.errorCode.size() <= 64 &&
        data.createdAt is timestamp;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'addedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidAdminEmailDoc(data) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['email', 'addedBy', 'createdAt']) &&
        isValidEmailId(data.email) &&
        data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    // 1. Platform Management Admins Registry (UID + Email)
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(uid) &&
        isValidAdminDoc(incoming()) &&
        incoming().uid == uid &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(uid) && uid != request.auth.uid;
    }

    match /adminEmails/{emailId} {
      allow get: if isVerifiedUser() && isValidEmailId(emailId) && (userEmailLower() == emailId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidEmailId(emailId) &&
        isValidAdminEmailDoc(incoming()) &&
        incoming().email == emailId &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidEmailId(emailId) && userEmailLower() != emailId;
    }

    // 2. Private Business Profiles (Management Admin + Assigned Business Client)
    match /businesses/{businessId} {
      allow get: if isVerifiedUser() && isValidId(businessId) && (isAdmin() || (resource != null && isAssignedClient(existing())));
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidBusiness(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('qrStandLimit' in incoming()) || incoming().qrStandLimit == 4 || isAdmin()) &&
        (
          isAdmin() ||
          (incoming().clientEmail == userEmailLower() && incoming().clientAccessLevel == 'full')
        );
      allow update: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidBusiness(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Platform Management full administration (includes qrStandLimit approval)
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerName', 'clientEmail', 'clientUid', 'clientAccessLevel', 'enabledFeatures',
              'name', 'category', 'address', 'phone', 'contactEmail', 'website',
              'googleReviewUrl', 'logoDataUrl', 'branding', 'qrConfig',
              'questions', 'formTemplate', 'seoKeywords', 'slug', 'qrStandLimit', 'gbpSettings', 'weeklyReportConfig',
              'lifecycleStatus', 'tenantFirebase', 'updatedAt'
            ])
          ) ||
          // Action 2: Assigned Client with 'full' tier (cannot modify qrStandLimit or permissions)
          (
            isAssignedClient(existing()) &&
            existing().clientAccessLevel == 'full' &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().clientAccessLevel == existing().clientAccessLevel &&
            incoming().enabledFeatures == existing().enabledFeatures &&
            (!('qrStandLimit' in incoming()) || ('qrStandLimit' in existing() && incoming().qrStandLimit == existing().qrStandLimit)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerName', 'name', 'category', 'address', 'phone', 'contactEmail', 'website',
              'googleReviewUrl', 'logoDataUrl', 'branding', 'qrConfig',
              'questions', 'formTemplate', 'seoKeywords', 'slug', 'gbpSettings', 'weeklyReportConfig',
              'lifecycleStatus', 'tenantFirebase', 'updatedAt'
            ])
          ) ||
          // Action 3: Assigned Client with 'qr_and_questions' tier
          (
            isAssignedClient(existing()) &&
            existing().clientAccessLevel == 'qr_and_questions' &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().clientAccessLevel == existing().clientAccessLevel &&
            incoming().enabledFeatures == existing().enabledFeatures &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'qrConfig', 'questions', 'formTemplate', 'updatedAt'
            ])
          ) ||
          // Action 4: Assigned Client links verified clientUid for Portal event history
          (
            isAssignedClient(existing()) &&
            incoming().clientUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'clientUid', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(businessId) && (isAdmin() || existing().ownerId == request.auth.uid);
    }

    // 3. Public Customer Form Profiles (Keyed by slug, zero PII)
    match /publicProfiles/{slug} {
      allow get: if isValidSlug(slug) && (
        resource == null ||
        resource.data.qrConfig.isActive == true ||
        isAdmin() ||
        (isVerifiedUser() && resource.data.ownerId == request.auth.uid)
      );
      allow list: if isVerifiedUser() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidSlug(slug) &&
        isValidPublicProfile(incoming()) &&
        incoming().slug == slug &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/businesses/$(incoming().businessId)) &&
        (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerifiedUser() &&
        isValidSlug(slug) &&
        isValidPublicProfile(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().businessId == existing().businessId &&
        incoming().slug == existing().slug &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'clientUid', 'name', 'category', 'googleReviewUrl', 'logoDataUrl',
              'enabledFeatures', 'branding', 'qrConfig', 'questions', 'formTemplate', 'seoKeywords',
              'lifecycleStatus', 'tenantFirebase', 'updatedAt'
            ])
          ) ||
          (
            exists(/databases/$(database)/documents/businesses/$(existing().businessId)) &&
            isAssignedClient(get(/databases/$(database)/documents/businesses/$(existing().businessId)).data) &&
            (
              (
                get(/databases/$(database)/documents/businesses/$(existing().businessId)).data.clientAccessLevel == 'full' &&
                incoming().enabledFeatures == existing().enabledFeatures &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'name', 'category', 'googleReviewUrl', 'logoDataUrl',
                  'branding', 'qrConfig', 'questions', 'formTemplate', 'seoKeywords',
                  'lifecycleStatus', 'tenantFirebase', 'updatedAt'
                ])
              ) ||
              (
                get(/databases/$(database)/documents/businesses/$(existing().businessId)).data.clientAccessLevel == 'qr_and_questions' &&
                incoming().enabledFeatures == existing().enabledFeatures &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'qrConfig', 'questions', 'formTemplate', 'updatedAt'
                ])
              ) ||
              (
                incoming().clientUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'clientUid', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isVerifiedUser() && isValidSlug(slug) && (isAdmin() || existing().ownerId == request.auth.uid);
    }

    // 4. Per-Business Aggregate Stats
    match /businessStats/{businessId} {
      allow get: if isVerifiedUser() && isValidId(businessId) && (
        isAdmin() ||
        (resource != null && isAssignedClient(existing())) ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          isAssignedClient(get(/databases/$(database)/documents/businesses/$(businessId)).data)
        )
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidBusinessStats(incoming()) &&
        incoming().businessId == businessId &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/businesses/$(businessId)) &&
        (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(businessId) &&
        isValidBusinessStats(incoming()) &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().businessId == existing().businessId &&
            incoming().ownerId == existing().ownerId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['clientEmail', 'slug', 'updatedAt'])
          ) ||
          (
            isAssignedClient(existing()) &&
            exists(/databases/$(database)/documents/businesses/$(businessId)) &&
            get(/databases/$(database)/documents/businesses/$(businessId)).data.clientAccessLevel == 'full' &&
            incoming().businessId == existing().businessId &&
            incoming().ownerId == existing().ownerId &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().diff(existing()).affectedKeys().hasOnly(['slug', 'updatedAt'])
          ) ||
          (
            incoming().businessId == existing().businessId &&
            incoming().ownerId == existing().ownerId &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().slug == existing().slug &&
            exists(/databases/$(database)/documents/publicProfiles/$(existing().slug)) &&
            get(/databases/$(database)/documents/publicProfiles/$(existing().slug)).data.qrConfig.isActive == true &&
            incoming().scans >= existing().scans && incoming().scans <= existing().scans + 1 &&
            incoming().generated >= existing().generated && incoming().generated <= existing().generated + 1 &&
            incoming().redirects >= existing().redirects && incoming().redirects <= existing().redirects + 1 &&
            incoming().styleShort >= existing().styleShort && incoming().styleShort <= existing().styleShort + 1 &&
            incoming().styleDetailed >= existing().styleDetailed && incoming().styleDetailed <= existing().styleDetailed + 1 &&
            incoming().styleProfessional >= existing().styleProfessional && incoming().styleProfessional <= existing().styleProfessional + 1 &&
            (
              (incoming().scans == existing().scans + 1 && incoming().generated == existing().generated && incoming().redirects == existing().redirects && (!('formsStarted' in existing()) || incoming().formsStarted == existing().formsStarted)) ||
              (incoming().generated == existing().generated + 1 && incoming().scans == existing().scans && incoming().redirects == existing().redirects && (!('formsStarted' in existing()) || incoming().formsStarted == existing().formsStarted)) ||
              (incoming().redirects == existing().redirects + 1 && incoming().scans == existing().scans && incoming().generated == existing().generated && (!('formsStarted' in existing()) || incoming().formsStarted == existing().formsStarted)) ||
              (
                ((!('formsStarted' in existing()) && incoming().formsStarted == 1) || ('formsStarted' in existing() && incoming().formsStarted == existing().formsStarted + 1)) &&
                incoming().scans == existing().scans &&
                incoming().generated == existing().generated &&
                incoming().redirects == existing().redirects
              )
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'scans', 'formsStarted', 'generated', 'redirects',
              'styleShort', 'styleDetailed', 'styleProfessional', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(businessId) && (isAdmin() || existing().ownerId == request.auth.uid);
    }

    // 5. Immutable Review Analytics Events
    match /reviewEvents/{eventId} {
      allow get: if isVerifiedUser() && isValidId(eventId) && (
        isAdmin() ||
        (resource != null && (
          existing().ownerId == request.auth.uid ||
          (existing().clientUid is string && existing().clientUid.size() > 0 && existing().clientUid == request.auth.uid)
        ))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.clientUid is string && resource.data.clientUid.size() > 0 && resource.data.clientUid == request.auth.uid)
      );
      allow create: if isValidId(eventId) &&
        isValidReviewEvent(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/publicProfiles/$(incoming().slug)) &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.qrConfig.isActive == true &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.ownerId == incoming().ownerId &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.businessId == incoming().businessId &&
        (
          !('clientUid' in incoming()) ||
          incoming().clientUid == '' ||
          (
            'clientUid' in get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data &&
            incoming().clientUid == get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.clientUid
          )
        );
      allow update, delete: if false;
    }

    // 6. In-Store QR Stand Management (Deterministic slots enforce business qrStandLimit)
    match /qrStands/{standId} {
      allow get: if isVerifiedUser() && isValidId(standId) && (
        isAdmin() ||
        (resource != null && isAssignedClient(existing()))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(standId) &&
        isValidQrStand(incoming()) &&
        standId == (incoming().businessId + '_slot_' + string(incoming().slotNumber)) &&
        exists(/databases/$(database)/documents/businesses/$(incoming().businessId)) &&
        incoming().slotNumber <= getBusinessStandLimit(incoming().businessId) &&
        incoming().ownerId == get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isAssignedClient(get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data) &&
            get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.clientAccessLevel in ['qr_and_questions', 'full']
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(standId) &&
        isValidQrStand(incoming()) &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().slotNumber == existing().slotNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'clientUid', 'clientEmail', 'slug', 'standCode', 'name', 'placement',
              'isActive', 'fgColor', 'bgColor', 'includeLogo', 'updatedAt'
            ])
          ) ||
          (
            exists(/databases/$(database)/documents/businesses/$(existing().businessId)) &&
            isAssignedClient(get(/databases/$(database)/documents/businesses/$(existing().businessId)).data) &&
            get(/databases/$(database)/documents/businesses/$(existing().businessId)).data.clientAccessLevel in ['qr_and_questions', 'full'] &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'standCode', 'name', 'placement', 'isActive', 'fgColor', 'bgColor', 'includeLogo', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(standId) && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/businesses/$(existing().businessId)) &&
          isAssignedClient(get(/databases/$(database)/documents/businesses/$(existing().businessId)).data) &&
          get(/databases/$(database)/documents/businesses/$(existing().businessId)).data.clientAccessLevel in ['qr_and_questions', 'full']
        )
      );
    }

    // 7. Additional QR Stand Requests (Client creates pending; Admin approves/rejects)
    match /qrStandRequests/{requestId} {
      allow get: if isVerifiedUser() && isValidId(requestId) && (
        isAdmin() ||
        (resource != null && isAssignedClient(existing()))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidQrStandRequest(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/businesses/$(incoming().businessId)) &&
        incoming().ownerId == get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId &&
        (
          isAdmin() ||
          isAssignedClient(get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data)
        );
      allow update: if isAdmin() &&
        isValidId(requestId) &&
        isValidQrStandRequest(incoming()) &&
        existing().status == 'pending' &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().status in ['approved', 'rejected'] &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewedByUid', 'reviewedByEmail', 'adminNote', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // 8. Google Business Profile OAuth Connection Metadata (No secret tokens stored)
    match /gbpConnections/{businessId} {
      allow get: if isVerifiedUser() && isValidId(businessId) && (
        isAdmin() ||
        (resource != null && isAssignedClient(existing())) ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          isAssignedClient(get(/databases/$(database)/documents/businesses/$(businessId)).data)
        )
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidGbpConnection(incoming()) &&
        incoming().businessId == businessId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        incoming().ownerId == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId &&
        (
          isAdmin() ||
          (
            isAssignedClient(get(/databases/$(database)/documents/businesses/$(businessId)).data) &&
            get(/databases/$(database)/documents/businesses/$(businessId)).data.clientAccessLevel == 'full'
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidGbpConnection(incoming()) &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/businesses/$(businessId)) &&
            isAssignedClient(existing()) &&
            get(/databases/$(database)/documents/businesses/$(businessId)).data.clientAccessLevel == 'full' &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'connectionStatus', 'connectedEmail', 'accountName', 'locationName',
              'locationTitle', 'placeId', 'lastSyncedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(businessId);
    }

    // 9. Google Business Profile Reviews & AI Auto-Reply Workflow
    match /gbpReviews/{reviewId} {
      allow get: if isVerifiedUser() && isValidId(reviewId) && (
        isAdmin() ||
        (resource != null && isAssignedClient(existing()))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidGbpReview(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/businesses/$(incoming().businessId)) &&
        incoming().ownerId == get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId &&
        (
          isAdmin() ||
          (
            isAssignedClient(get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data) &&
            get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.clientAccessLevel == 'full'
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidGbpReview(incoming()) &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().externalReviewId == existing().externalReviewId &&
        incoming().starRating == existing().starRating &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'aiReplyText', 'replyStatus', 'aiProvider', 'aiModelId',
              'inputTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd',
              'errorMessage', 'publishedAt', 'updatedAt'
            ])
          ) ||
          (
            exists(/databases/$(database)/documents/businesses/$(existing().businessId)) &&
            isAssignedClient(existing()) &&
            get(/databases/$(database)/documents/businesses/$(existing().businessId)).data.clientAccessLevel == 'full' &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'aiReplyText', 'replyStatus', 'aiProvider', 'aiModelId',
              'inputTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd',
              'errorMessage', 'publishedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(reviewId);
    }

    // 10. Weekly Business Reports (Monday-Sunday snapshots)
    match /weeklyReports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (
        isAdmin() ||
        (resource != null && isAssignedClient(existing()))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidWeeklyReport(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/businesses/$(incoming().businessId)) &&
        incoming().ownerId == get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId &&
        (
          isAdmin() ||
          isAssignedClient(get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data)
        );
      allow update: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidWeeklyReport(incoming()) &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().weekStart == existing().weekStart &&
        incoming().weekEnd == existing().weekEnd &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'businessName', 'clientEmail', 'reviewGenMetrics', 'autoReplyMetrics', 'aiUsageMetrics',
              'dispatchedToEmails', 'dispatchedAt', 'generatedBy', 'updatedAt'
            ])
          ) ||
          (
            exists(/databases/$(database)/documents/businesses/$(existing().businessId)) &&
            isAssignedClient(existing()) &&
            incoming().clientEmail == existing().clientEmail &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'businessName', 'reviewGenMetrics', 'autoReplyMetrics', 'aiUsageMetrics',
              'dispatchedToEmails', 'dispatchedAt', 'generatedBy', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(reportId);
    }

    // 11. Central Non-Secret Business Infrastructure Summaries
    match /businessIntegrations/{businessId} {
      allow get: if isVerifiedUser() && isValidId(businessId) && (
        isAdmin() ||
        (resource != null && isAssignedClient(existing())) ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          isAssignedClient(get(/databases/$(database)/documents/businesses/$(businessId)).data)
        )
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidBusinessIntegration(incoming()) &&
        incoming().businessId == businessId &&
        incoming().updatedAt == request.time &&
        (isAdmin() || isAssignedClient(incoming()));
      allow update: if isVerifiedUser() &&
        isValidId(businessId) &&
        isValidBusinessIntegration(incoming()) &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time &&
        (isAdmin() || isAssignedClient(existing()));
      allow delete: if isVerifiedUser() && isValidId(businessId) && isAdmin();
    }

    // 12. Immutable AI Token Usage Logs Summary
    match /aiUsageLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (
        isAdmin() ||
        (resource != null && (
          existing().ownerId == request.auth.uid ||
          (existing().clientEmail is string && existing().clientEmail.size() > 0 && existing().clientEmail.lower() == userEmailLower())
        ))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (userEmailLower().size() > 0 && resource.data.clientEmail == userEmailLower())
      );
      allow create: if isValidId(logId) &&
        isValidAiUsageLog(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/businesses/$(incoming().businessId)) &&
        incoming().ownerId == get(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId;
      allow update, delete: if false;
    }

    // 13. Immutable Customer Feedback Submissions (preserved even if draft is deleted)
    match /feedbackSubmissions/{submissionId} {
      allow get: if isVerifiedUser() && isValidId(submissionId) && (
        isAdmin() ||
        (resource != null && (
          existing().ownerId == request.auth.uid ||
          (existing().clientUid is string && existing().clientUid.size() > 0 && existing().clientUid == request.auth.uid)
        ))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.clientUid is string && resource.data.clientUid.size() > 0 && resource.data.clientUid == request.auth.uid)
      );
      allow create: if isValidId(submissionId) &&
        isValidFeedbackSubmission(incoming()) &&
        incoming().submissionId == submissionId &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/publicProfiles/$(incoming().slug)) &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.qrConfig.isActive == true &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.ownerId == incoming().ownerId &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.businessId == incoming().businessId &&
        (
          !('clientUid' in incoming()) ||
          incoming().clientUid == '' ||
          (
            'clientUid' in get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data &&
            incoming().clientUid == get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.clientUid
          )
        );
      allow update, delete: if false;
    }

    // 14. Multilingual Customer Review Drafts (Generated -> Edited -> Copied -> Deleted)
    match /reviewDrafts/{draftId} {
      allow get: if isVerifiedUser() && isValidId(draftId) && (
        isAdmin() ||
        (resource != null && (
          existing().ownerId == request.auth.uid ||
          (existing().clientUid is string && existing().clientUid.size() > 0 && existing().clientUid == request.auth.uid)
        ))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.clientUid is string && resource.data.clientUid.size() > 0 && resource.data.clientUid == request.auth.uid)
      );
      allow create: if isValidId(draftId) &&
        isValidReviewDraft(incoming()) &&
        incoming().draftId == draftId &&
        incoming().status == 'Generated' &&
        incoming().createdAt == request.time &&
        incoming().generatedAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/publicProfiles/$(incoming().slug)) &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.qrConfig.isActive == true &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.ownerId == incoming().ownerId &&
        get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.businessId == incoming().businessId &&
        exists(/databases/$(database)/documents/feedbackSubmissions/$(incoming().feedbackSubmissionId)) &&
        get(/databases/$(database)/documents/feedbackSubmissions/$(incoming().feedbackSubmissionId)).data.businessId == incoming().businessId &&
        (
          !('clientUid' in incoming()) ||
          incoming().clientUid == '' ||
          (
            'clientUid' in get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data &&
            incoming().clientUid == get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.clientUid
          )
        );
      allow update: if isValidId(draftId) &&
        isValidReviewDraft(incoming()) &&
        incoming().draftId == existing().draftId &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().slug == existing().slug &&
        incoming().feedbackSubmissionId == existing().feedbackSubmissionId &&
        incoming().language == existing().language &&
        incoming().reviewStyle == existing().reviewStyle &&
        incoming().variationSeed == existing().variationSeed &&
        incoming().sessionId == existing().sessionId &&
        incoming().createdAt == existing().createdAt &&
        incoming().generatedAt == existing().generatedAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'reviewText', 'status', 'copiedAt', 'deletedAt', 'updatedAt'
            ])
          ) ||
          (
            existing().status != 'Deleted' &&
            exists(/databases/$(database)/documents/publicProfiles/$(existing().slug)) &&
            get(/databases/$(database)/documents/publicProfiles/$(existing().slug)).data.qrConfig.isActive == true &&
            (
              (
                incoming().status == 'Edited' &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'reviewText', 'status', 'updatedAt'
                ])
              ) ||
              (
                incoming().status == 'Copied' &&
                'copiedAt' in incoming() &&
                incoming().copiedAt == request.time &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'reviewText', 'status', 'copiedAt', 'updatedAt'
                ])
              ) ||
              (
                incoming().status == 'Deleted' &&
                'deletedAt' in incoming() &&
                incoming().deletedAt == request.time &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'deletedAt', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(draftId);
    }

    // 15. AI Quality Validation & Evaluation Telemetry (Phase 3 & 4)
    match /reviewEvaluations/{evalId} {
      allow get: if isVerifiedUser() && isValidId(evalId) && (
        isAdmin() ||
        (resource != null && (
          existing().ownerId == request.auth.uid ||
          (existing().clientUid is string && existing().clientUid.size() > 0 && existing().clientUid == request.auth.uid)
        ))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.clientUid is string && resource.data.clientUid.size() > 0 && resource.data.clientUid == request.auth.uid)
      );
      allow create: if isValidId(evalId) &&
        isValidReviewEvaluation(incoming()) &&
        incoming().evalId == evalId &&
        incoming().createdAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().source == 'live_customer' &&
            exists(/databases/$(database)/documents/publicProfiles/$(incoming().slug)) &&
            get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.qrConfig.isActive == true &&
            get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.ownerId == incoming().ownerId &&
            get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.businessId == incoming().businessId &&
            (
              !('clientUid' in incoming()) ||
              incoming().clientUid == '' ||
              (
                'clientUid' in get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data &&
                incoming().clientUid == get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.clientUid
              )
            )
          )
        );
      allow update: if false;
      allow delete: if isAdmin() && isValidId(evalId);
    }

    // 16. Anonymized Consented Training & Calibration Examples (Phase 5)
    match /consentedExamples/{exampleId} {
      allow get: if isValidId(exampleId) && (
        isAdmin() ||
        (resource != null && resource.data.curationStatus == 'approved') ||
        (isVerifiedUser() && resource != null && existing().ownerId == request.auth.uid)
      );
      allow list: if isAdmin() ||
        resource.data.curationStatus == 'approved' ||
        (isVerifiedUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(exampleId) &&
        isValidConsentedExample(incoming()) &&
        incoming().exampleId == exampleId &&
        incoming().consentGiven == true &&
        incoming().curationStatus == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/publicProfiles/$(incoming().slug)) &&
            get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.qrConfig.isActive == true &&
            get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.ownerId == incoming().ownerId &&
            get(/databases/$(database)/documents/publicProfiles/$(incoming().slug)).data.businessId == incoming().businessId
          )
        );
      allow update: if isAdmin() &&
        isValidId(exampleId) &&
        isValidConsentedExample(incoming()) &&
        incoming().exampleId == existing().exampleId &&
        incoming().businessId == existing().businessId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'finalReview', 'curationStatus', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(exampleId);
    }
  }
}
