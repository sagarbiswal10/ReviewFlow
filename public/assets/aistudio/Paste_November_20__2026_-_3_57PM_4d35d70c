        btn.className = 'tone-btn py-1 rounded-lg text-[11px] font-label-md bg-surface-subtle text-text-secondary text-center hover:bg-teal-wash';
      }
    });
    regenerateDraft();
  }

  // Dynamic Draft Synthesizer
  function regenerateDraft() {
    const textField = document.getElementById('generated-review-text');
    const servicesJoined = selectedServices.join(' and ');
    
    if (currentTone === 'warm') {
      textField.innerText = `"Had an incredible ${servicesJoined.toLowerCase()} session at Lumina Studio today! The stylist listened so closely to what I wanted and delivered exactly what I envisioned. Warm atmosphere and genuine care from start to finish."`;
