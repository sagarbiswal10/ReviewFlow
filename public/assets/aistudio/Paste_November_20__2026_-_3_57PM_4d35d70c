    if (selectedServices.includes(service)) {
      if (selectedServices.length > 1) {
        selectedServices = selectedServices.filter(s => s !== service);
        button.className = 'service-chip px-2.5 py-1 rounded-full text-[12px] font-label-md bg-surface-subtle text-text-secondary border-none hover:bg-teal-wash transition-all';
      }
    } else {
      selectedServices.push(service);
      button.className = 'service-chip px-2.5 py-1 rounded-full text-[12px] font-label-md bg-teal-wash text-primary border-none shadow-sm transition-all';
    }
    regenerateDraft();
  }

  // Interactive Mobile Simulator: Tone Switching
