      textField.innerText = `"Excellent ${servicesJoined.toLowerCase()} at Lumina Studio. Punctual, very clean salon, and skilled staff. Highly recommended."`;
    } else {
      textField.innerText = `"Booked a visit for ${servicesJoined.toLowerCase()} at Lumina Studio. The consultation was thorough, the technique was flawless, and the final results exceeded expectations. Five stars all around."`;
    }
  }

