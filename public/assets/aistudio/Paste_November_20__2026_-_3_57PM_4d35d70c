      mobileView.classList.add('hidden');
      ownerView.classList.remove('hidden');
      btnOwner.className = 'px-5 py-2 rounded-full font-label-md text-label-md transition-all duration-200 bg-surface-container-lowest text-primary shadow-sm flex items-center gap-2';
