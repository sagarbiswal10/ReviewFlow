{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Owner and management-controlled business profile, client assignment, permissions, branding, QR settings, QR stand limits, GBP reply settings, weekly report settings, and feedback form configuration.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerName": {
          "type": "string",
          "description": "Full name of the business owner.",
          "maxLength": 120
        },
        "clientEmail": {
          "type": "string",
          "description": "Normalized lowercase email of the assigned business client for Portal access.",
          "maxLength": 120
        },
        "clientUid": {
          "type": "string",
          "description": "Linked non-PII Firebase Auth UID of the assigned client for analytics event reads.",
          "maxLength": 128
        },
        "clientAccessLevel": {
          "type": "string",
          "description": "Self-service editing tier granted to the business client in /portal.",
          "enum": ["read_only", "qr_and_questions", "full"]
        },
        "enabledFeatures": {
          "type": "object",
          "description": "Feature entitlements active for this business (aiReviewDrafts, customQuestions, pdfPosterExport, analyticsView, inStoreQrStands, gbpAutoReply, weeklyReports, formTemplates, qrStudio, brandingSettings)."
        },
        "slug": {
          "type": "string",
          "description": "URL-safe unique identifier for customer review links.",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the business.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Business industry category.",
          "enum": [
            "Restaurants",
            "Hair Salons",
            "Beauty Salons",
            "Hotels",
            "Spas",
            "Gyms",
            "Healthcare",
            "Retail Stores",
            "Automobile Services",
            "Other Businesses"
          ]
        },
        "address": {
          "type": "string",
          "maxLength": 240
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 120
        },
        "website": {
          "type": "string",
          "maxLength": 300
        },
        "googleReviewUrl": {
          "type": "string",
          "maxLength": 500
        },
        "logoDataUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "branding": {
          "type": "object"
        },
        "qrConfig": {
          "type": "object"
        },
        "questions": {
          "type": "array"
        },
        "formTemplate": {
          "type": "string",
          "description": "Selected customer feedback form template identifier.",
          "enum": [
            "classic_cards",
            "emoji_checklist_light",
            "emoji_checklist_dark",
            "warm_editorial",
            "split_executive",
            "quick_tap_express",
            "spatial_glass_3d",
            "neo_brutal_3d",
            "obsidian_cyber_3d",
            "clay_soft_3d"
          ]
        },
        "packageTier": {
          "type": "string",
          "description": "Growth plan package tier controlling language & SEO features.",
          "enum": ["standard", "standard_plus"]
        },
        "reviewFlowMode": {
          "type": "string",
          "description": "QR landing experience: 5+ instant ready AI drafts or guided feedback questions.",
          "enum": ["ai_drafted_instant", "guided_questions"]
        },
        "allowClientFlowModeSwitch": {
          "type": "boolean",
          "description": "Whether the business client may switch between instant AI drafts and guided questions."
        },
        "locality": {
          "type": "string",
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "maxLength": 120
        },
        "servicesOffered": {
          "type": "array",
          "description": "Services offered by this business for contextual SEO."
        },
        "productsOffered": {
          "type": "array",
          "description": "Products offered by this business for contextual SEO."
        },
        "businessHighlights": {
          "type": "string",
          "maxLength": 500
        },
        "seoKeywords": {
          "type": "array",
          "description": "Auto-generated Google Maps & Search SEO keywords tailored to business name and category."
        },
        "seoKeywordsByLanguage": {
          "type": "object",
          "description": "Language-specific contextual SEO keyword lists keyed by en/hi/mr/hinglish."
        },
        "referenceReviews": {
          "type": "array",
          "description": "Isolated genuine customer reviews used as writing style reference per business."
        },
        "qrStandLimit": {
          "type": "integer",
          "description": "Maximum number of QR stands allowed for this business (default 4, admin-controlled)."
        },
        "gbpSettings": {
          "type": "object",
          "description": "Rating-based Google Business Profile AI Auto Reply rules and brand voice."
        },
        "weeklyReportConfig": {
          "type": "object",
          "description": "Weekly Monday-Sunday automated business report configuration and recipients."
        },
        "lifecycleStatus": {
          "type": "string",
          "enum": ["onboarding", "provisioning", "active", "suspended"]
        },
        "tenantFirebase": {
          "type": "object",
          "description": "Public WebApp config for this business's dedicated Firebase project."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "clientEmail",
        "clientAccessLevel",
        "enabledFeatures",
        "slug",
        "name",
        "category",
        "address",
        "phone",
        "contactEmail",
        "googleReviewUrl",
        "logoDataUrl",
        "branding",
        "qrConfig",
        "questions",
        "createdAt",
        "updatedAt"
      ]
    },
